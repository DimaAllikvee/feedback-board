# ==============================================================================
# FeedbackPulse SaaS - Environment Variables Template
# Copy this file to .env.local for local development or set them in Coolify UI
# ==============================================================================

# Public URL of the deployed PocketBase instance (e.g. https://pb.your-domain.com or http://127.0.0.1:8090)
VITE_POCKETBASE_URL=

# Stripe Public Publishable Key (Stripe Test Mode for Grade "A")
# Obtainable from Stripe Dashboard: https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLIC_KEY=

# Stripe Webhook Signing Secret (Backend only - NEVER expose in client bundles)
STRIPE_WEBHOOK_SECRET=

# PocketBase Admin Master Credentials (Used for initial CLI migration scripts)
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
